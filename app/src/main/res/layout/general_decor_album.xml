<?xml version="1.0" encoding="utf-8"?>
<!-- Kiosk variant used ONLY for the song list inside an album.
     The three visible actions use 96dp hit areas (normal: 48dp).
     Buttons are below the song count to fit narrow portrait displays. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="156dp">

    <TextView
        android:id="@+id/song_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        app:textFontWeight="600" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="96dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/play_all"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/rp_buttons"
            android:contentDescription="@string/play_all"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_play_arrow"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="52dp"
            app:iconTint="@color/kiosk_play_red"
            app:tooltipText="@string/play_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shuffle_all"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/rp_buttons"
            android:contentDescription="@string/shuffle_all"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_shuffle"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="44dp"
            app:iconTint="?attr/colorPrimary"
            app:tooltipText="@string/shuffle_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sort"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/rp_buttons"
            android:contentDescription="@string/sort"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_sort"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="48dp"
            app:iconTint="?attr/colorPrimary"
            app:tooltipText="@string/sort" />
    </LinearLayout>

    <!-- Required by BaseDecorAdapter.ViewHolder, permanently hidden here. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/create_playlist"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/jumpUp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/jumpDown"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
